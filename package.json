{
    "name": "swachhlens",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node dev.js",
        "dev:api": "node server.js --port 3000",
        "dev:web": "vite",
        "dev:ai": "cd swachhlens-ai && python main.py",
        "dev:all": "node dev.js --all",
        "build": "vite build",
        "preview": "node server.js",
        "start": "node server.js",
        "start:all": "concurrently -n ai,api,web -c magenta,cyan,green \"cd swachhlens-ai && python main.py\" \"node server.js --port 3000\" \"vite\""
    },
    "dependencies": {
        "@clerk/react": "^6.14.3",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.3.1",
        "@mui/material": "^9.3.1",
        "@react-oauth/google": "^0.13.5",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "leaflet": "^1.9.4",
        "maplibre-gl": "^6.4.0",
        "pg": "^8.23.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-leaflet": "^5.0.0",
        "react-router-dom": "^7.18.2",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.5",
        "postcss": "^8.5.26",
        "puppeteer-core": "^25.8.0",
        "tailwindcss": "^3.4.19",
        "vite": "^8.2.1",
        "vite-plugin-pwa": "^1.3.0"
    }
}
