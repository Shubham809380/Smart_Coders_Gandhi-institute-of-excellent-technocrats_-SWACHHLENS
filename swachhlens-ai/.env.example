# SwachhLens AI Backend - Environment Variables
# Copy to .env and adjust as needed

# --- Server ---
AI_SERVICE_URL=http://localhost:8000
NODE_BACKEND_URL=http://localhost:3000

# --- Model Paths (defaults work for auto-downloaded models) ---
# YOLO_MODEL_PATH=checkpoints/yolo11m.pt
# YOLO_ONNX_PATH=checkpoints/best.onnx
# SAM_CHECKPOINT=checkpoints/sam_vit_b_01ec64.pth
# DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
# CLIP_MODEL=openai/clip-vit-base-patch32
# SEVERITY_MODEL_PATH=checkpoints/severity_model.json

# --- Feature Flags (set false to use fallback/heuristic) ---
USE_YOLO=true
USE_SAM=true
USE_DEPTH=true
USE_CLIP=true
USE_XGBOOST=false
USE_CUDA=false

# --- Device ---
# DEVICE=cpu  (auto-detected from USE_CUDA)

# --- Duplicate Detection ---
DUP_DISTANCE_METERS=50
DUP_TIME_WINDOW_HOURS=24
DUP_SIMILARITY_THRESHOLD=0.85

# --- DBSCAN Clustering ---
CLUSTER_EPS_METERS=50
CLUSTER_MIN_SAMPLES=3
