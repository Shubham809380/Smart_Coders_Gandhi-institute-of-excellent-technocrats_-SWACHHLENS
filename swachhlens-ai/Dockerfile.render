# Slim CPU-only image for Render free tier (512MB RAM).
# Only the trained CNN classifier + heuristic fallbacks are enabled:
#   USE_YOLO / USE_SAM / USE_DEPTH / USE_CLIP / USE_XGBOOST are all off.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.render.txt .
RUN pip install --no-cache-dir -r requirements.render.txt

COPY . .

ENV USE_YOLO=false
ENV USE_SAM=false
ENV USE_DEPTH=false
ENV USE_CLIP=false
ENV USE_XGBOOST=false
ENV DEVICE=cpu

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
