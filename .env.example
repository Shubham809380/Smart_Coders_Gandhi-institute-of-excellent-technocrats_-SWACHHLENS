# === DATABASE (Neon PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === AUTH ===
AUTH_PROVIDER=neon
JWT_SECRET=your-random-secret-here

# === AI PROVIDER ===
# "mock" for hackathon deploy (no Python needed)
# "onnx" for production: trained CNN runs inside the serverless function
#        (best_classifier.onnx via onnxruntime-node; no Python service needed)
# "python" for local dev with the full FastAPI pipeline in swachhlens-ai/
AI_PROVIDER=onnx

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === EMAIL (Brevo or Resend — Brevo key wins if both set) ===
# Brevo: https://app.brevo.com/settings/keys/api — keys start with "xkeysib-"
BREVO_API_KEY=
# Resend: https://resend.com/api-keys — keys start with "re_"
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=SwachhLens <onboarding@resend.dev>

# === YOLO (optional, only for python mode) ===
YOLO_ENDPOINT_URL=
YOLO_API_KEY=
YOLO_TIMEOUT_MS=15000

# === SERVER ===
PORT=3000

# === REALTIME BRIDGE (Socket.IO on Render) ===
# Where this API forwards live events to. Empty = SSE only (local monolith mode).
# Production example: https://swachhlens-socket.onrender.com/internal/emit
SOCKET_INTERNAL_URL=
# Shared secret with the Render socket service (/internal/emit auth).
# Use the SAME value on both services.
INTERNAL_API_SECRET=

# === RENDER SOCKET SERVICE ONLY ===
# Comma-separated allowed browser origins for Socket.IO + REST (no trailing slash).
FRONTEND_URL=http://localhost:5173

# === FRONTEND (Vite, VITE_ prefix required) ===
# Socket.IO endpoint the browser connects to. Empty = legacy SSE fallback.
# Production example: https://swachhlens-socket.onrender.com
VITE_SOCKET_URL=
