# === API / REALTIME URLS ===
# REST + AI APIs are same-origin in production (Vercel rewrite /api/* -> api/index.js).
# Keep empty unless the API is served from a different origin AND sends CORS headers.
VITE_API_URL=
# Socket.IO server on Render. REQUIRED for production realtime.
# Production example: https://swachhlens-socket.onrender.com
VITE_SOCKET_URL=http://localhost:3001

# === GOOGLE OAUTH ===
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# === CLOUDINARY (optional, for image uploads) ===
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=
